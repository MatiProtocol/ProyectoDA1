    private void AddNewDependency()
    {
        var dep = project.Tasks.FirstOrDefault(t => t.Title == newDepTitle);
        if (dep == null)
        {
            depErrorMessage = "Tarea no exite";
            return;
        }

        if (!Enum.TryParse(typeDependencies, out TypeDependency type))
        {
            depErrorMessage = "Tipo de dependencia desconocida";
            return;
        }

        var err = _projectService.AddDependencyToTask(_sessionService.GetCurrent()!, project!,
            new TaskGraphService.Edge()
            {
                targetDto = task!,
                depDto = dep,
                type = type

            });

        if (err != null)
        {
            depErrorMessage = err.GetMessage();
            return;
        }

        Reset();
    }

    private TaskDTO[] GetPossibleTaskDto()
    {
        var deps = _projectService.GetTaskDependencies(project, task)!;

        var list = new List<TaskDTO>();

        foreach (var taskItem in project.Tasks)
        {
            if (deps.FirstOrDefault(t => t.task.Title == taskItem.Title) != default || !_projectService.TaskDependencyVerifyEdge(project, task, taskItem)) continue;

            list.Add(taskItem);
        }

        return list.ToArray();
    }

