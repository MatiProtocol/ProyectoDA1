@page "/proyectos"
@using Auxiliaries
@using Services
@using Services.DTOs
@inject NavigationManager NavManager
@inject IJSRuntime Js
@implements IDisposable

@if(_sessionService.GetCurrent() == null) NavManager.NavigateTo("/");

<PageTitle>Proyectos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="m-0 lh-1">Lista de proyectos activos</h1>
    
    @if(_sessionService.GetCurrent().Role >= Roles.ProjectLeader)
    {
        <div class="d-flex justify-content">
            <button type="button" class="btn btn-outline-primary" @onclick="() => ExportLeaderProject(true)">
                Exportar Json
            </button>
            <button type="button" class="btn btn-outline-primary" @onclick="() => ExportLeaderProject(false)">
                Exportar CSV
            </button>
                
            @if (_sessionService.GetCurrent()!.Role >= Roles.ProjectManager)
            {
                <NavLink style="aspect-ratio: 1 / 1; width: 3rem;" class="nav-link p-0 d-flex  justify-content-center align-items-center btn btn-outline-info" href="/proyecto/crear">
                    <h1 class="lh-1 m-0 text-info">+</h1>
                </NavLink>
            }
        </div>
    }
</div>

@if (_sessionService.GetCurrent() != null)
{
    <div class="card bg-transparent border-primary-subtle">
        @if (_sessionService.GetCurrent()!.Role == Roles.SystemManager)
        {
            <div class="form-check ms-2">
                <input class="form-check-input" type="checkbox" value="" id="ShowAllProjects" @onclick="ToggleProjectList">
                <label class="form-check-label" for="ShowAllProjects">
                    Mostrar Todos los proyectos
                </label>
            </div>
        }
    </div>

    <div class="card text-center mt-2">
        @foreach (var project in _projectList)
        {
            <div class="card-header bg-body-tertiary">
                @project.Name
            </div>
            <div class="card-body bg-body">
                @project.Description
            </div>
            <div class="card-footer border-primary-subtle text-body-secondary border-bottom bg-body-tertiary d-flex justify-content-between align-items-center">
                @if (_sessionService.GetCurrent()!.Role == Roles.SystemManager)
                {
                    <div class="accordion border-primary-subtle" id="accordionOptionsSysmanager">
                        <div class="accordion-item bg-transparent border-primary-subtle">
                            <h2 class="accordion-header bg-transparent border-primary-subtle">
                                <button class="accordion-button bg-primary text-light border-primary-subtle" 
                                        type="button" 
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#@project.Name.GetHashCode()"
                                        aria-expanded="true" 
                                        aria-controls="@project.Name.GetHashCode()"
                                >
                                    Opciones
                                </button>
                            </h2>
                            <div id="@project.Name.GetHashCode()" 
                                 class="accordion-collapse collapse bg-transparent border-primary-subtle mt-2" 
                                 data-bs-parent="#accordionOptionsSysmanager"
                            >
                                <button class="btn btn-danger" 
                                        id="UnAssignProjectManager" 
                                        type="button" 
                                        @onclick="() => RemoveManager(project)"
                                >
                                    Remover administrador
                                </button>
                                <button class="btn btn-danger" 
                                        id="DeleteProject" 
                                        type="button" 
                                        @onclick="() => DeleteProject(project)"
                                >
                                    Eliminar proyecto
                                </button>
                                <div class="accordion-body p-0">
                                    <div class="dropdown mt-2">
                                        <label for="OptionSysManagerDropdown">
                                            Asignar administrador del proyecto:
                                        </label>
                                        <button class="btn btn-secondary dropdown-toggle mb-1" id="OptionSysManagerDropdown"
                                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Seleccionar administrador
                                        </button>
                                        <ul class="dropdown-menu">
                                            @foreach (var user in _userService.GetAllUserWhichCanAdminNewProject())
                                            {
                                                <li><a class="dropdown-item"
                                                       @onclick="() => AssignManager(project, user)">@($"{user.Name} | {user.LastName} | {user.Email}")</a></li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (_projectService.IsPartOfTheProject(_sessionService.GetCurrent(), project))
                {
                    <NavLink type="button"
                             class="nav-link btn btn-primary w-25 bg-primary"
                             @onclick="() => NavigateToProject(project.Name)"
                    >
                         Entrar
                    </NavLink>
                }
            </div>
        }
    </div>
}

@code {
    private readonly SessionService _sessionService = SessionService.GetInstance();
    private readonly ProjectService _projectService = ProjectService.GetInstance();
    private readonly UserService _userService = UserService.GetInstance();

    private Reactivity _reactivity = Reactivity.GetInstance();
    private bool _showAllProjects = false;
    private ProjectDTO[]? _projectList;

    private void ToggleProjectList()
    {
        _showAllProjects = !_showAllProjects;
        _projectList = _showAllProjects
            ? _projectService.GetAllProjectsDto()
            : _projectService.GetProjectsByUser(_sessionService.GetCurrent());
    }

    protected override void OnInitialized()
    {
        _reactivity.OnChange += Change;
        if (_sessionService.GetCurrent() != null)
        {
            _projectList = _projectService.GetProjectsByUser(_sessionService.GetCurrent());
        }
    }

    public void Dispose()
    {
        _reactivity.OnChange -= Change;
    }

    private void Change()
    {
        _projectList = _showAllProjects
            ? _projectService.GetAllProjectsDto()
            : _projectService.GetProjectsByUser(_sessionService.GetCurrent());
        InvokeAsync(StateHasChanged);
    }

    private void NavigateToProject(string projectName)
    {
        NavManager.NavigateTo($"/proyecto/{projectName}");
    }

    private void AssignManager(ProjectDTO project,UserDTO newManager)
    {
        _projectService.AddManagerToProject(_sessionService.GetCurrent()!,newManager, project);
    }

    private void RemoveManager(ProjectDTO project)
    {
        _projectService.RemoveManagerFromProject(_sessionService.GetCurrent()!,project);
    }

    private void DeleteProject(ProjectDTO project)
    {
        _projectService.DeleteProject(_sessionService.GetCurrent(), project.Name);
    }

    private void ExportLeaderProject(bool exportJson)
    {
        var (downloader, error) = 
            _projectService.ExportProject(_sessionService.GetCurrent(), exportJson);
        
        if (error != null)
        {
            return;
        }
        
        var content = downloader!.Value.Content;
        var fileName = downloader.Value.FileName;
        var mimeType = downloader.Value.Content;

        Js.InvokeVoidAsync("downloadFileFromText", fileName, content, mimeType);
    }

}
